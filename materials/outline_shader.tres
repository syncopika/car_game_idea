[gd_resource type="ShaderMaterial" load_steps=3 format=2]

[ext_resource path="res://textures/gtr_texture.png" type="Texture" id=1]

[sub_resource type="Shader" id=1]
code = "shader_type spatial;

uniform vec2 resolution;
uniform sampler2D diffuse;
uniform sampler2D depthTexture;

float getDiffuseValueAtPoint(int x, int y, vec2 textureSize, vec2 uv){
    vec2 point = vec2(float(x), float(y));
    vec2 texelSize = vec2(1.0 / textureSize.x, 1.0 / textureSize.y);
    vec4 color = texture(diffuse, uv + texelSize * point);
    return color.r;
}

float combinedSobelValue(vec2 uv){
    vec2 textureSize = vec2(textureSize(diffuse, 0));
    
    // kernel definition (in glsl matrices are filled in column-major order)
    const mat3 Gx = mat3(vec3(-1, -2, -1), vec3(0, 0, 0), vec3(1, 2, 1));// x direction kernel
    const mat3 Gy = mat3(vec3(-1, 0, 1), vec3(-2, 0, 2), vec3(-1, 0, 1));// y direction kernel

    // fetch the 3x3 neighborhood of the fragment
    // first column
    float tx0y0 = getDiffuseValueAtPoint(-1, -1, textureSize, uv);
    float tx0y1 = getDiffuseValueAtPoint(-1, 0, textureSize, uv);
    float tx0y2 = getDiffuseValueAtPoint(-1, 1, textureSize, uv);

    // second column
    float tx1y0 = getDiffuseValueAtPoint(0, -1, textureSize, uv);
    float tx1y1 = getDiffuseValueAtPoint(0, 0, textureSize, uv);
    float tx1y2 = getDiffuseValueAtPoint(0, 1, textureSize, uv);

    // third column
    float tx2y0 = getDiffuseValueAtPoint(1, -1, textureSize, uv);
    float tx2y1 = getDiffuseValueAtPoint(1, 0, textureSize, uv);
    float tx2y2 = getDiffuseValueAtPoint(1, 1, textureSize, uv);

    // gradient value in x direction
    float valueGx = Gx[0][0] * tx0y0 + Gx[1][0] * tx1y0 + Gx[2][0] * tx2y0 +
    Gx[0][1] * tx0y1 + Gx[1][1] * tx1y1 + Gx[2][1] * tx2y1 +
    Gx[0][2] * tx0y2 + Gx[1][2] * tx1y2 + Gx[2][2] * tx2y2;

    // gradient value in y direction
    float valueGy = Gy[0][0] * tx0y0 + Gy[1][0] * tx1y0 + Gy[2][0] * tx2y0 +
    Gy[0][1] * tx0y1 + Gy[1][1] * tx1y1 + Gy[2][1] * tx2y1 +
    Gy[0][2] * tx0y2 + Gy[1][2] * tx1y2 + Gy[2][2] * tx2y2;

    // magnitude of the total gradient
    float G = (valueGx * valueGx) + (valueGy * valueGy);
    return clamp(G, 0.0, 1.0);
}

void fragment(){
	float sobelValue = combinedSobelValue(UV);

	sobelValue = smoothstep(0.01, 0.03, sobelValue);

	vec4 lineColor = vec4(0.3, 0.3, 0.3, 1.0);

	if (sobelValue > 0.1) {
	    //COLOR = lineColor;
		// https://forum.godotengine.org/t/3d-healthbar-shader-issue-with-setting-color-solved/76376/3
		ALBEDO = vec3(lineColor.r, lineColor.g, lineColor.b);
		//ALPHA = lineColor.a;
	} else {
	    //COLOR = vec4(0.0);
		ALBEDO = vec3(0.0, 0.0, 0.0);
	}
}"

[resource]
shader = SubResource( 1 )
shader_param/resolution = null
shader_param/diffuse = ExtResource( 1 )
