[gd_resource type="Shader" format=2]

[resource]
code = "shader_type spatial;

uniform sampler2D diffuse;

// https://github.com/syncopika/threejs-projects/blob/master/shaders/shaders/waterShader.js
void fragment(){
	float tau = 6.28318530718;
	int max_iter = 6;
	
	vec3 water_color = vec3(1.0, 1.0, 1.0) * 0.5;
	
	float time = TIME * 0.5 + 23.0;
	
	vec2 p = mod(UV * tau, tau) - 250.0;
	vec2 i = vec2(p);
	float c = 1.0;
	float inten = 0.005;
	
	for(int n = 0; n < max_iter; n++){
		float t = time * (1.0 - (3.5 / float(n + 1)));
		i = p + vec2(cos(t - i.x) + sin(t + i.y), sin(t - i.y) + cos(t + i.x));
		c += 1.0 / length(vec2(p.x / (sin(i.x + t) / inten), p.y / (cos(i.y + t) / inten)));
	}
	
	c /= float(max_iter);
	c = 1.17 - pow(c, 1.4);
	
	vec3 color = vec3(pow(abs(c), 15.0));
	color = clamp((color + water_color) * 1.2, 0.0, 1.0);
	
	vec2 tc = vec2(cos(c) - 0.75, sin(c) - 0.75) * 0.04;
	vec2 uv = clamp(UV + tc, 0.0, 1.0);
	
	vec4 currColor = texture(diffuse, UV);
	
	ALBEDO = vec3(currColor.r, currColor.g, currColor.b) * color;
}"
